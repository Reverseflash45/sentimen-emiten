# Salin ke .env lalu sesuaikan
DATABASE_URL=sqlite:///./sentimen.db
# Contoh PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:sandi@localhost:5432/sentimen

# Identitas crawler — WAJIB diisi alamat yang bisa dihubungi (NF-09)
USER_AGENT=SentimenEmitenBot/0.1 (+mailto:rffernanditoo@gmail.com)

# Jeda antar permintaan ke satu portal, dalam detik
CRAWL_DELAY=2.0

# Batas berita yang diambil per sumber tiap siklus
MAX_ITEMS_PER_SOURCE=40

# Kunci penanda tangan token sesi — WAJIB diganti.
# Buat nilai acak dengan:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-kunci-ini-sebelum-dipakai-serius

# Masa berlaku token sesi, dalam jam
TOKEN_BERLAKU_JAM=12
